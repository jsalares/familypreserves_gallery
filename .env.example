# ---------------------------------------------------------------------------
# Family Preserves gallery settings. Copy this file to .env and fill it in.
# Never commit .env: it holds passwords.
# ---------------------------------------------------------------------------

# --- On the Kamatera server ------------------------------------------------

# The public address customers use (Caddy serves HTTPS for it).
PUBLIC_URL=https://gallery.familypreserves.ca

# The app listens only on this machine; Caddy forwards to it.
HOST=127.0.0.1
PORT=3010

# Where the database lives. Back this folder up.
# DATA_DIR=C:\familypreserves_gallery\data

# Long random strings. Make each one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
ADMIN_TOKEN=

# Photo storage: "r2" for Cloudflare R2, or "local" to keep files in DATA_DIR
# (fine for trying things out on your own PC).
STORAGE=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=familypreserves-gallery

# --- On your PC, for the upload tool ---------------------------------------
# Only these two are needed on the PC. Use the same ADMIN_TOKEN as the server.
# GALLERY_URL=https://gallery.familypreserves.ca
# ADMIN_TOKEN=
